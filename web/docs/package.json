{
  "name": "sylox-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run generate:contract-reference",
    "dev": "next dev",
    "prebuild": "npm run generate:contract-reference",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretest": "npm run generate:contract-reference",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:contract-reference": "node scripts/generate-contract-reference.mjs",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sylox/sdk": "*",
    "@sylox/ui": "*",
    "fumadocs-core": "16.17.1",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/mdx": "2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
