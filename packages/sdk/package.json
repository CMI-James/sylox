{
  "name": "@sylox/sdk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate:networks": "node scripts/generate-networks.mjs",
    "prebuild": "npm run generate:networks",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run generate:networks",
    "test": "vitest run",
    "test:watch": "vitest",
    "bindings:generate": "node scripts/generate-bindings.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": "17.2.1"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "17.2.1",
    "@types/node": "^20",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
